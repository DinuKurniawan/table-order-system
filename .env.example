# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/coffeeshop?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/coffeeshop?schema=public"

# App
APP_BASE_URL="http://localhost:3000"
# Origin tambahan yang diizinkan untuk mutasi (dipisah koma, opsional)
ALLOWED_ORIGINS=""
# Sumber IP klien: vercel | cloudflare | none | <jumlah hop x-forwarded-for>
TRUSTED_PROXY="none"
# Secret wajib diisi dengan nilai acak (minimal 32 karakter). Nilai contoh ditolak di production.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="GANTI_DENGAN_HASIL_PERINTAH_DI_README"
CRON_SECRET="GANTI_DENGAN_HASIL_PERINTAH_DI_README"

# Cloudflare R2 (S3 API)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_PUBLIC="coffeeshop-public"
R2_BUCKET_PRIVATE="coffeeshop-private"
R2_PUBLIC_BASE_URL="https://pub-xxxxxx.r2.dev"

# Pusher Channels (Server)
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="ap1"

# Pusher Channels (Client)
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# Seed admin (wajib diisi; tidak ada kredensial default)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""

# Opsional (CI / S3Mock)
# R2_FORCE_PATH_STYLE="true"
# DISABLE_REALTIME="true"

# CSP (SEC-04): default Report-Only karena shell PPR tanpa nonce.
# Set true hanya setelah prerender statis/PPR dimatikan.
CSP_ENFORCE="false"
# Paksa Report-Only walau CSP_ENFORCE=true (uji staging).
CSP_REPORT_ONLY="false"
