# Lingkungan khusus `npm test`.
# Tes integrasi mensimulasikan satu reverse proxy dengan header X-Forwarded-For,
# jadi mode hop=1 dipakai agar setiap skenario memakai bucket rate limit sendiri.
# File ini tidak memuat rahasia. DB uji lokal terpisah dari DB produksi;
# CI menimpanya lewat env job (Postgres service).
DATABASE_URL="postgresql://postgres@localhost:5432/coffeeshop_test?schema=public"
DIRECT_URL="postgresql://postgres@localhost:5432/coffeeshop_test?schema=public"
DATABASE_URL_POOLED="postgresql://postgres@localhost:5432/coffeeshop_test?schema=public"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="TestAdminPass-9f3a72"
APP_BASE_URL="http://localhost:3000"
SESSION_SECRET="test-session-secret-0123456789abcdef0123456789abcdef"
CRON_SECRET="test-cron-secret-0123456789abcdef0123456789abcdef"
PUSHER_APP_ID="test"
PUSHER_KEY="test"
PUSHER_SECRET="test"
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY="test"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"
DISABLE_REALTIME="true"
TRUSTED_PROXY=1
